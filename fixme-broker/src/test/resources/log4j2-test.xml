<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de test : le SplitTerminalAppender de production pilote le curseur du
  terminal en ANSI, ce qui rend la sortie de surefire illisible et pollue le
  System.out capture par les tests de CLI. En test on log donc sur stderr.
-->
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>
