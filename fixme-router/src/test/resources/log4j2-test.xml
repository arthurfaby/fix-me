<?xml version="1.0" encoding="UTF-8"?>
<!-- Config de test : logs en WARN sur stderr, pour garder la sortie surefire
     lisible malgre les tests de charge (1000 cycles, flood 10 Mo). -->
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>
