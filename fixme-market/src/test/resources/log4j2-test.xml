<?xml version="1.0" encoding="UTF-8"?>
<!-- in prod the SplitTerminalAppender writes ANSI to System.out and pollutes the
     tests that capture it; in test we log to stderr -->

<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>
